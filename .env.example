# Supabase: Project settings > Database > Connection string > "Transaction pooler" (port 6543).
# Replace [YOUR-PASSWORD]. If it has special characters, URL-encode them.
DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-region.pooler.supabase.com:6543/postgres
# Optional: set RATE_LIMIT_SECRET to a long random secret for auth throttling identifiers.
